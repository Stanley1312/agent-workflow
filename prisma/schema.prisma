generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  POOR
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  passwordHash String
  image        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  listings     Listing[] @relation("ListingOwner")
  reviews      Review[]  @relation("ReviewAuthor")
  receivedReviews Review[] @relation("ReviewTarget")

  @@index([createdAt])
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  displayName      String
  bio              String?
  avatarUrl        String?
  ratingAverage    Float    @default(0)
  ratingCount      Int      @default(0)
  reviewCount      Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ratingAverage])
  @@index([ratingCount])
}

model Listing {
  id              String            @id @default(cuid())
  ownerId         String
  profileId       String?
  title           String
  description     String
  price           Decimal           @db.Decimal(10, 2)
  category        String
  condition       ListingCondition   @default(GOOD)
  isPublished     Boolean           @default(true)
  primaryImageUrl String?
  ratingAverage   Float             @default(0)
  ratingCount     Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  owner           User              @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profile         Profile?          @relation(fields: [profileId], references: [id], onDelete: SetNull)
  images          ListingImage[]
  reviews         Review[]

  @@index([ownerId])
  @@index([profileId])
  @@index([isPublished, createdAt])
  @@index([category])
  @@index([price])
}

model ListingImage {
  id          String   @id @default(cuid())
  listingId   String
  url         String
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
}

model Review {
  id           String       @id @default(cuid())
  authorId     String
  targetUserId String
  listingId    String?
  rating       Int
  content      String
  status       ReviewStatus @default(PUBLISHED)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  author       User         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser   User         @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  listing      Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([targetUserId])
  @@index([listingId])
  @@index([rating])
  @@index([createdAt])
}
